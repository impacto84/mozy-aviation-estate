{
  "name": "mozy-private-aviation-estate",
  "version": "2.0.0",
  "private": true,
  "description": "MOZY Private Aviation Estate — site institucional flagship (Next.js App Router, FORJA 1.0).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -p ${PORT:-3140}",
    "build": "NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=1536 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=1536 sh -c 'next typegen && tsc --noEmit'",
    "lint": "eslint . --max-warnings 0",
    "test": "NODE_OPTIONS=--max-old-space-size=1536 vitest run --maxWorkers=1",
    "test:cov": "NODE_OPTIONS=--max-old-space-size=1536 vitest run --maxWorkers=1 --coverage",
    "verify": "sh scripts/verify.sh"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "gsap": "3.15.1",
    "lenis": "1.3.28",
    "next": "16.4.6",
    "ogl": "1.0.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "@axe-core/playwright": "4.14.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "playwright": "1.63.0",
    "playwright-core": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
