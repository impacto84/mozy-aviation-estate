# Variáveis de ambiente do site MOZY. Copie para .env.local e preencha só o que usar.
# Nenhum valor aqui é segredo; nunca commite .env/.env.local.

# URL pública canônica (sitemap, canonical, Open Graph). Padrão local: http://127.0.0.1:3140
NEXT_PUBLIC_SITE_URL=

# Google Tag Manager (formato GTM-XXXXXXX). Vazio = nenhuma tag carregada.
NEXT_PUBLIC_GTM_ID=

# Formulário externo opcional (link de conversão com UTM preservado).
NEXT_PUBLIC_FORM_URL=

# Só servidor: destino HTTPS que recebe o lead por POST JSON (prazo de 8 s).
LEAD_WEBHOOK_URL=

# Só servidor: diretório de gravação NDJSON dos leads (padrão .data/leads, fora do git; "off" desliga).
LEADS_STORAGE_DIR=
